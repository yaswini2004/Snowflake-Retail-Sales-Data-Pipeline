//B.Trasnformation Layer

// Creationg funtion to extract the year from order id
CREATE OR REPLACE FUNCTION get_order_year(order_id VARCHAR)
RETURNS NUMBER(4)
LANGUAGE SQL
AS
$$
    TRY_TO_NUMBER(REGEXP_SUBSTR(order_id, '20[0-9]{2}'))
$$;
//Displaying the order year using the get_order_year funtion
SELECT
    ORDER_ID,
    GET_ORDER_YEAR(ORDER_ID) AS ORDER_YEAR
FROM retail_sales_table
LIMIT 10;

//Creating a function to calculates the number of days between ORDER_DATE and SHIP_DATE.
CREATE OR REPLACE FUNCTION calculate_days_to_ship(
    order_date DATE,
    ship_date DATE
)
RETURNS NUMBER(3)
LANGUAGE SQL
AS
$$
    DATEDIFF('DAY', order_date, ship_date)
$$;
//displaying day to ship
SELECT
    ORDER_DATE,
    SHIP_DATE,
    calculate_days_to_ship(ORDER_DATE, SHIP_DATE) AS DAYS_TO_SHIP
FROM retail_sales_table
LIMIT 10;
//Creating a function to removes the CUST- prefix and converts the remaining value to a number.
CREATE OR REPLACE FUNCTION standardize_customer_id(customer_id VARCHAR)
RETURNS NUMBER(10)
LANGUAGE SQL
AS
$$
    TRY_TO_NUMBER(REGEXP_REPLACE(customer_id, '[^0-9]', ''))
$$;
// Displaying the Standardized/updated clean Customer_ID
SELECT
    CUSTOMER_ID,
    standardize_customer_id(CUSTOMER_ID) AS CLEAN_ID
FROM retail_sales_table
LIMIT 10;
//Creating a function to removes non-numeric prefixes/suffixes and converts the value to NUMBER(10)
CREATE OR REPLACE FUNCTION standardize_order_id(order_id VARCHAR)
RETURNS NUMBER(10)
LANGUAGE SQL
AS
$$
    TRY_TO_NUMBER(REGEXP_REPLACE(order_id, '[^0-9]', ''))
$$;
//displaying the standardized order id
SELECT
    ORDER_ID,
    standardize_order_id(ORDER_ID)
FROM  retail_sales_table
LIMIT 10;
//Creating a function to removes non-numeric prefixes/suffixes and converts the value to NUMBER(10) from Product_ID
CREATE OR REPLACE FUNCTION standardize_product_id(product_id VARCHAR)
RETURNS NUMBER(10)
LANGUAGE SQL
AS
$$
    TRY_TO_NUMBER(REGEXP_REPLACE(product_id, '[^0-9]', ''))
$$;
//Displaying the standardized product_id
SELECT
    PRODUCT_ID,
    standardize_product_id(PRODUCT_ID)
FROM retail_sales_table
LIMIT 10;

//Create a function to a reliable SALES metric per order, derived from PRICE × QUANTITY.
CREATE OR REPLACE FUNCTION calculate_sales(
    price NUMBER,
    quantity NUMBER
)
RETURNS NUMBER(15,5)
LANGUAGE SQL
AS
$$
    ROUND(price * quantity, 5)
$$;
// Displaying the calculated sales
SELECT
    PRICE,
    QUANTITY,
    CALCULATE_SALES(PRICE, QUANTITY) AS SALES
FROM retail_sales_table
LIMIT 10;

//Creating the target RETAIL_sales
CREATE OR REPLACE TABLE Retail_sales (
    order_id NUMBER(10),
    order_date DATE,
    ship_date DATE,
    ship_mode VARCHAR(200),
    customer_id NUMBER(10),
    customer_name VARCHAR(300),
    segment VARCHAR(100),
    country VARCHAR(100),
    city VARCHAR(100),
    state VARCHAR(100),
    postal_code NUMBER(10),
    region VARCHAR(100),
    product_id NUMBER(10),
    category VARCHAR(100),
    sub_category VARCHAR(100),
    price NUMBER(10,4),
    quantity NUMBER(3),
    discount NUMBER(7,2),
    order_year NUMBER(4),
    days_to_ship NUMBER(3),
    sales NUMBER(15,5)
);

//Inserting all transformed data into Retail_table
INSERT INTO Retail_sales (
    order_id,
    order_date,
    ship_date,
    ship_mode,
    customer_id,
    customer_name,
    segment,
    country,
    city,
    state,
    postal_code,
    region,
    product_id,
    category,
    sub_category,
    price,
    quantity,
    discount,
    order_year,
    days_to_ship,
    sales
)
SELECT
    standardize_order_id(order_id) AS order_id,
    order_date,
    ship_date,
    ship_mode,
    standardize_customer_id(customer_id) AS customer_id,
    customer_name,
    segment,
    country,
    city,
    state,
    postal_code,
    region,
    standardize_product_id(product_id) AS product_id,
    category,
    sub_category,
    price,
    quantity,
