//C.PROCESSING LAYER
CREATE OR REPLACE STREAM SALES_STREAM
ON TABLE RETAIL_SALES_TABLE;

SELECT
    METADATA$ACTION,
    METADATA$ISUPDATE,
    METADATA$ROW_ID,
    ORDER_ID,
    CUSTOMER_ID,
    PRODUCT_ID
FROM SALES_STREAM;


// Snowflake Task can automatically execute the includes inserts, updates, and deletes every day.

CREATE OR REPLACE TASK PROCESS_SALES_DAILY
    WAREHOUSE = COMPUTE_WH
    SCHEDULE = 'USING CRON 0 2 * * * Asia/Kolkata'
    WHEN SYSTEM$STREAM_HAS_DATA('SALES_STREAM')
AS
MERGE INTO RETAIL_sales AS TARGET

USING (
    SELECT
        standardize_order_id(order_id) AS order_id,
        order_date,
        ship_date,
        ship_mode,
        standardize_customer_id(customer_id) AS customer_id,
        customer_name,
        segment,
        country,
        city,
        state,
        postal_code,
        region,
        standardize_product_id(product_id) AS product_id,
        category,
        sub_category,
        price,
        quantity,
        discount,
        get_order_year(order_id) AS order_year,
        calculate_days_to_ship(order_date, ship_date) AS days_to_ship,
        calculate_sales(price, quantity) AS sales,
        METADATA$ACTION AS CHANGE_TYPE

    FROM SALES_STREAM

    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY STANDARDIZE_ORDER_ID(ORDER_ID)
        ORDER BY
            CASE
                WHEN METADATA$ACTION = 'INSERT' THEN 1
                ELSE 2
            END
    ) = 1

) AS SOURCE

ON TARGET.ORDER_ID = SOURCE.ORDER_ID

WHEN MATCHED
     AND SOURCE.CHANGE_TYPE = 'DELETE'
THEN DELETE

WHEN MATCHED
     AND SOURCE.CHANGE_TYPE = 'INSERT'
THEN UPDATE SET
    TARGET.ORDER_DATE = SOURCE.ORDER_DATE,
    TARGET.SHIP_DATE = SOURCE.SHIP_DATE,
    TARGET.SHIP_MODE = SOURCE.SHIP_MODE,
    TARGET.CUSTOMER_ID = SOURCE.CUSTOMER_ID,
    TARGET.CUSTOMER_NAME = SOURCE.CUSTOMER_NAME,
    TARGET.SEGMENT = SOURCE.SEGMENT,
    TARGET.COUNTRY = SOURCE.COUNTRY,
    TARGET.CITY = SOURCE.CITY,
    TARGET.STATE = SOURCE.STATE,
    TARGET.POSTAL_CODE = SOURCE.POSTAL_CODE,
    TARGET.REGION = SOURCE.REGION,
    TARGET.PRODUCT_ID = SOURCE.PRODUCT_ID,
    TARGET.CATEGORY = SOURCE.CATEGORY,
    TARGET.SUB_CATEGORY = SOURCE.SUB_CATEGORY,
    TARGET.PRICE = SOURCE.PRICE,
    TARGET.QUANTITY = SOURCE.QUANTITY,
    TARGET.DISCOUNT = SOURCE.DISCOUNT,
    TARGET.ORDER_YEAR = SOURCE.ORDER_YEAR,
    TARGET.DAYS_TO_SHIP = SOURCE.DAYS_TO_SHIP,
    TARGET.SALES = SOURCE.SALES

WHEN NOT MATCHED
     AND SOURCE.CHANGE_TYPE = 'INSERT'
THEN INSERT (
    ORDER_ID,
    ORDER_DATE,
    SHIP_DATE,
    SHIP_MODE,
    CUSTOMER_ID,
    CUSTOMER_NAME,
    SEGMENT,
    COUNTRY,
    CITY,
    STATE,
    POSTAL_CODE,
    REGION,
    PRODUCT_ID,
    CATEGORY,
    SUB_CATEGORY,
    PRICE,
    QUANTITY,
    DISCOUNT,
    ORDER_YEAR,
    DAYS_TO_SHIP,
    SALES
)

VALUES (
    SOURCE.ORDER_ID,
    SOURCE.ORDER_DATE,
    SOURCE.SHIP_DATE,
    SOURCE.SHIP_MODE,
    SOURCE.CUSTOMER_ID,
    SOURCE.CUSTOMER_NAME,
    SOURCE.SEGMENT,
    SOURCE.COUNTRY,
    SOURCE.CITY,
    SOURCE.STATE,
    SOURCE.POSTAL_CODE,
    SOURCE.REGION,
    SOURCE.PRODUCT_ID,
    SOURCE.CATEGORY,
    SOURCE.SUB_CATEGORY,
    SOURCE.PRICE,
    SOURCE.QUANTITY,
    SOURCE.DISCOUNT,
    SOURCE.ORDER_YEAR,
    SOURCE.DAYS_TO_SHIP,
    SOURCE.SALES
);

