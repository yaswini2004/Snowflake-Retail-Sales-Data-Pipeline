    get_order_year(order_id) AS order_year,
    calculate_days_to_ship(order_date, ship_date) AS days_to_ship,
    calculate_sales(price, quantity) AS sales
FROM retail_sales_table;

// Validating final table
SELECT * FROM Retail_sales
