//Ingestion layer
// File format creation
 CREATE OR REPLACE FILE Format Retail_csv_format
    TYPE = 'CSV'
    FIELD_DELIMITER = ','
    SKIP_HEADER = 1
    FIELD_OPTIONALLY_ENCLOSED_BY = '"'
    TRIM_SPACE = TRUE
    NULL_IF = ('NULL', 'null', '')
    ENCODING = 'ISO-8859-1';


//Creating Stage
CREATE OR REPLACE STAGE Retail_Raw_Data
    FILE_FORMAT = Retail_csv_format;

//verifying whether the csv data is loaded into the stage
List @Retail_Raw_Data;

//Previewing the data that present in the stage and validating it
SELECT 
    $1::NUMBER AS row_id,
    $2::VARCHAR(50) AS order_id,
    $3::DATE AS order_date,
    $4::DATE AS ship_date,
    $5::VARCHAR(200) AS ship_mode,
    $6::VARCHAR(50) AS customer_id,
    $7::VARCHAR(300) AS customer_name,
    $8::VARCHAR(100) AS segment,
    $9::VARCHAR(100) AS country,
    $10::VARCHAR(100) AS city,
    $11::VARCHAR(100) AS state,
    $12::VARCHAR(20) AS postal_code,
    $13::VARCHAR(100) AS region,
    $14::VARCHAR(50) AS product_id,
    $15::VARCHAR(100) AS category,
    $16::VARCHAR(100) AS sub_category,
    $17::VARCHAR(500) AS product_name,
    $18::NUMBER(10,4) AS price,
    $19::NUMBER(3) AS quantity,
    $20::NUMBER(7,2) AS discount
FROM @Retail_Raw_Data
LIMIT 10;
// creating a table and copying the data from stage to table 
CREATE OR REPLACE TABLE Retail_sales_table (
    ROW_ID NUMBER,
    ORDER_ID VARCHAR(50),
    ORDER_DATE DATE,
    SHIP_DATE DATE,
    SHIP_MODE VARCHAR(200),
    CUSTOMER_ID VARCHAR(50),
    CUSTOMER_NAME VARCHAR(300),
    SEGMENT VARCHAR(100),
    COUNTRY VARCHAR(100),
    CITY VARCHAR(100),
    STATE VARCHAR(100),
    POSTAL_CODE VARCHAR(20),
    REGION VARCHAR(100),
    PRODUCT_ID VARCHAR(50),
    CATEGORY VARCHAR(100),
    SUB_CATEGORY VARCHAR(100),
    PRODUCT_NAME VARCHAR(500),
    PRICE NUMBER(10,4),
    QUANTITY NUMBER(3),
    DISCOUNT NUMBER(7,2)
);

//COPY THE DATA FROM STAGE TO TABLE
COPY INTO Retail_Sales_Table
FROM @Retail_Raw_Data
FILE_FORMAT = (
    FORMAT_NAME = 'Retail_csv_format'
)
ON_ERROR = 'CONTINUE';

