WITH MONTHLY_REVENUE AS (
    SELECT
        DATE_TRUNC('MONTH', ORDER_DATE) AS ORDER_MONTH,
        REGION,
        CATEGORY,
        SUM(
            PRICE * QUANTITY * (1 - DISCOUNT)
        ) AS REVENUE
    FROM RETAIL_SALES
    WHERE ORDER_DATE >= DATEADD(
        MONTH,
        -6,
        (SELECT MAX(ORDER_DATE) FROM RETAIL_SALES)
    )
    GROUP BY
        DATE_TRUNC('MONTH', ORDER_DATE),
        REGION,
        CATEGORY
),
REVENUE_TEXT AS (
    SELECT
        TO_VARCHAR(ORDER_MONTH, 'YYYY-MM')
        || ' | Region: ' || REGION
        || ' | Category: ' || CATEGORY
        || ' | Revenue: ' || ROUND(REVENUE, 2) AS TREND_TEXT
    FROM MONTHLY_REVENUE
)
SELECT AI_SUMMARIZE(TREND_TEXT) AS REVENUE_TREND_SUMMARY
FROM REVENUE_TEXT;

CREATE OR REPLACE VIEW DAILY_REVENUE_BY_REGION AS
SELECT
    ORDER_DATE,
    REGION,
    SUM(
        PRICE * QUANTITY * (1 - DISCOUNT)
    ) AS DAILY_REVENUE
FROM RETAIL_SALES
GROUP BY
    ORDER_DATE,
    REGION;

SELECT *
FROM DAILY_REVENUE_BY_REGION
ORDER BY ORDER_DATE, REGION
LIMIT 20;

CREATE OR REPLACE SNOWFLAKE.ML.FORECAST RETAIL_REVENUE_FORECAST(
    INPUT_DATA => TABLE(DAILY_REVENUE_BY_REGION),
    SERIES_COLNAME => 'REGION',
    TIMESTAMP_COLNAME => 'ORDER_DATE',
    TARGET_COLNAME => 'DAILY_REVENUE',
    CONFIG_OBJECT => {
        'frequency': '1 day'
    }
);
